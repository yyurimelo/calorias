{
  "name": "calorias",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "back",
    "front"
  ],
  "scripts": {
    "dev": "concurrently -n back,front -c blue,green \"npm:dev:back\" \"npm:dev:front\"",
    "dev:back": "npm run dev --workspace back",
    "dev:front": "npm run dev --workspace front",
    "build": "npm run build --workspace back && npm run build --workspace front",
    "build:back": "npm run build --workspace back",
    "build:front": "npm run build --workspace front",
    "lint": "npm run lint --workspace front",
    "start:front": "npm run start --workspace front",
    "format": "prettier --write \"back/**/*.{ts,js,json}\" \"front/**/*.{ts,tsx,js,jsx,json,css}\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
